# Никогда не публикуйте реальный ключ. Скопируйте файл как .env только локально.
# Ключ API создаётся на platform.openai.com → API keys и начинается с sk-.
# Коды активации кредитов и ChatGPT сюда не подходят: ключ без sk- игнорируется.
OPENAI_API_KEY=
# Название модели, доступной в вашем аккаунте OpenAI.
OPENAI_MODEL=gpt-6-luna
AI_ENABLED=true

# Секрет для подписи JWT (любая длинная случайная строка). Пусто — временный ключ, вход сбрасывается при перезапуске.
JWT_SECRET=
MAX_FILE_MB=25

# Для запуска без Docker оставьте пустым — будет использовано хранилище в памяти.
DATABASE_URL=
PORT=4180
# 0.0.0.0 — чтобы мобильное приложение в той же Wi-Fi сети видело сервер; 127.0.0.1 — только этот компьютер.
HOST=0.0.0.0
